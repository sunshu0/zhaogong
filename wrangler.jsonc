{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhaogong-demo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "zhaogong-demo",
    },
  ],
  // The database (ADR 0029, ADR 0031). Created once with `wrangler d1 create zhaogong --location=oc` (Oceania); put the
  // id it prints here. Local previews and `wrangler d1 migrations apply zhaogong --local` work without it.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zhaogong",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
  "vars": {
    "NEXTJS_ENV": "production",
  },
}
