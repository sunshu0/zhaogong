{
  "name": "zhaogong",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8701",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview --port 8704",
    "cf:dry-run": "npm run cf:build && wrangler deploy --dry-run",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:d1": "vitest run --config vitest.d1.config.mts",
    "test:e2e": "playwright test",
    "e2e:build": "node scripts/e2e-server.mjs build",
    "e2e:start": "node scripts/e2e-server.mjs start",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{ts,mts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{ts,mts,mjs}\"",
    "postinstall": "patch-package",
    "db:generate": "drizzle-kit generate",
    "db:reset": "node scripts/db-reset.mjs",
    "ai:smoke": "tsx scripts/ai-post-smoke.mjs",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "admin:grant": "tsx src/db/cli.ts admin:grant",
    "admin:revoke": "tsx src/db/cli.ts admin:revoke",
    "import:external": "tsx src/db/cli.ts import:external"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.55.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@opennextjs/cloudflare": "1.20.10",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "miniflare": "5.20261006.2-beta",
    "patch-package": "8.0.1",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "4.150.0"
  }
}
